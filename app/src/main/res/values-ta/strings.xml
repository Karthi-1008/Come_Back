<resources>
    <string name="app_name">ComeBack</string>
    <string name="welcome_title">நன்றாக உண்ணுங்கள், தினமும்</string>
    <string name="welcome_subtitle">நீங்கள் உண்பதை பதிவு செய்யுங்கள், உங்கள் முழு நாளின் சத்துக்களையும் காணுங்கள்.</string>
    <string name="sign_in_google">Google மூலம் உள்நுழைக</string>
    <string name="wellness_note">நல்வாழ்வு வழிகாட்டுதல் மட்டுமே, மருத்துவ ஆலோசனை அல்ல.</string>
    <string name="offline_note">உள்நுழைந்த பிறகு இணையம் இல்லாமலும் செயல்படும்.</string>

    <string name="err_no_internet">தற்போது இணைய இணைப்பு இல்லை. உள்நுழைய ஒருமுறை இணையத்தை இணைக்கவும்.</string>
    <string name="err_cancelled">உள்நுழைவு ரத்து செய்யப்பட்டது. நீங்கள் எப்போது வேண்டுமானாலும் மீண்டும் முயற்சிக்கலாம்.</string>
    <string name="err_no_account">இந்த போனில் Google கணக்கு எதுவும் இல்லை. அமைப்புகளில் சேர்த்து மீண்டும் முயற்சிக்கவும்.</string>
    <string name="err_play_services">Google Play சேவைகள் இல்லை அல்லது புதுப்பிக்கப்பட வேண்டும்.</string>
    <string name="err_not_configured">இந்த பதிப்பில் உள்நுழைவு இன்னும் அமைக்கப்படவில்லை.</string>
    <string name="err_generic">ஏதோ தவறு நிகழ்ந்துவிட்டது. தயவுசெய்து மீண்டும் முயற்சிக்கவும்.</string>

